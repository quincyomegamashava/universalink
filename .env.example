# AI Platform — environment template
# Copy to .env and adjust before deploy: cp .env.example .env
# Production: prefer scripts/aws-production-setup.sh (generates secrets + TLS).

# --- Host / public URL ---
DOMAIN=localhost
PUBLIC_URL=http://localhost:8088
# Production: PUBLIC_URL=https://ai.example.com

# --- Open WebUI ---
WEBUI_SECRET_KEY=change-me-to-a-long-random-string
WEBUI_NAME="AI Platform"

# --- Ollama ---
OLLAMA_HOST=0.0.0.0
# Keep model resident (-1). Use 5m only if VRAM/RAM is tight.
OLLAMA_KEEP_ALIVE=-1
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
# CPU-friendly default first; add llama3.2:3b / mistral:7b on GPU hosts
OLLAMA_MODELS="llama3.2:1b llama3.2:3b"

# --- Backend (Phase 2+) ---
APP_NAME="AI Platform API"
# Use development locally (allows placeholder secrets + create_all).
# Production refuses change-me* secrets — set via rotate-secrets / aws-production-setup.
APP_ENV=development
APP_DEBUG=false
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:8088
# Production: CORS_ORIGINS=https://ai.example.com
# Cookies: Secure when PUBLIC_URL is https:// (override with COOKIE_SECURE=true|false)
# COOKIE_SECURE=
# Production default: invite-only (admins create users). Set true for open signup.
REGISTRATION_ENABLED=false

# Bootstrap admin (created on first backend start if missing)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMeAdmin123!
ADMIN_NAME="Platform Admin"

# --- PostgreSQL ---
POSTGRES_USER=aiplatform
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=aiplatform
DATABASE_URL=postgresql+asyncpg://aiplatform:change-me-strong-db-password@postgres:5432/aiplatform

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Qdrant ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=documents

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_ADMIN_PER_MINUTE=120

# --- Ollama internal URL (Docker network) ---
OLLAMA_BASE_URL=http://ollama:11434
# Open WebUI → backend bridge so chat can select virtual model "auto"
# (requires: docker compose --profile full). Falls back to Ollama if unset.
OPEN_WEBUI_OLLAMA_URL=http://backend:8000/ollama
OPEN_WEBUI_DEFAULT_MODELS=auto

# --- Embeddings / RAG ---
EMBEDDING_MODEL=nomic-embed-text
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RAG_TOP_K=5
DEFAULT_CHAT_MODEL=llama3.2:1b

# --- Uploads ---
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=50

# --- Agents (Phase 7) ---
AGENT_WORKSPACE_DIR=/data/agent-workspace
AGENT_TERMINAL_ALLOWLIST=ls,pwd,cat,head,tail,wc,echo,date,uname,df,du,find,grep,rg,git
AGENT_TERMINAL_TIMEOUT_SEC=30
AGENT_MAX_ITERATIONS=8
# AGENT_DB_URL=  # defaults to DATABASE_URL (read-only SELECT)
# GITHUB_TOKEN=
# DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_READ_ONLY=true
# SMTP (optional — enables emailed password-reset links)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_USE_TLS=true
AWS_REGION=us-east-1

# --- Monitoring (bound to 127.0.0.1 — SSH tunnel to reach) ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me-grafana
